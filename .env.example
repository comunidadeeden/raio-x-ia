# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — use the Project URL and publishable/anon key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Use the project's secret/service-role key; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart 2.0
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID=
HOTMART_PRODUCT_UCODE=
# Conservative defaults keep current access when commercial rules are ambiguous.
HOTMART_DELAYED_POLICY=keep_current
HOTMART_CANCELED_POLICY=keep_current

# Resend / Supabase Auth SMTP
RESEND_API_KEY=
EMAIL_FROM=Raio X <acesso@dominio.com>

# AI — provider/model form the Vercel AI Gateway model id: provider/model.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Chat rate limit (per user, per window)
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
